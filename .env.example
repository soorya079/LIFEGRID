# Local development defaults are placeholders; do not add real credentials here.
APP_MODE=mock
AWS_REGION=us-east-1
API_BASE_URL=http://localhost:8000
LIFEGRID_DATA_DIR=backend/data
LIFEGRID_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Leave cloud identifiers blank until an AWS deployment is deliberately configured.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
S3_BUCKET=
DYNAMODB_TABLES=
SNS_TOPIC_ARN=

# Optional browser-facing identifiers are not secrets. Never put AWS keys,
# private tokens, or privileged credentials in variables bundled into the UI.