# Frontend environment variables for LIFEGRID
# Copy this file to .env and fill in values for local development.
# For production, set VITE_API_BASE_URL as a GitHub Actions secret:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
#   Name: VITE_API_BASE_URL
#   Value: https://<your-api-id>.execute-api.ap-south-1.amazonaws.com/prod

# Local development (FastAPI running locally):
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (AWS API Gateway — replace with your actual URL):
VITE_API_BASE_URL=https://<your-api-id>.execute-api.ap-south-1.amazonaws.com/prod